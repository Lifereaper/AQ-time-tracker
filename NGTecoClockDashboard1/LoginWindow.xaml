<Window x:Class="NGTecoClockDashboard.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - NGTeco Dashboard" Height="420" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F4F6F9">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">

            <!-- Header -->
            <TextBlock Text="NGTeco Dashboard" FontSize="22" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
            <TextBlock Text="Please sign in to continue" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,5,0,25"/>

            <!-- Username Input -->
            <TextBlock Text="Username / User ID" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsername" Height="36" FontSize="14" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,15"/>

            <!-- Password Input -->
            <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="36" FontSize="14" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,20"/>

            <!-- Status / Error Message -->
            <TextBlock x:Name="lblError" Foreground="#E11D48" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap"/>

            <!-- Buttons -->
            <Button x:Name="btnLogin" Content="Login" Height="40" Background="#2563EB" Foreground="White" 
                    FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnLogin_Click" IsDefault="True">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Exit" Height="30" Background="Transparent" BorderThickness="0" Foreground="#64748B" 
                    FontSize="12" Margin="0,10,0,0" Cursor="Hand" Click="BtnExit_Click"/>
        </StackPanel>
    </Grid>
</Window>