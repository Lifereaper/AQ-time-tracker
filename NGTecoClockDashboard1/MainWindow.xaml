<Window x:Class="NGTecoClockDashboard1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attendance Clock Dashboard" Height="680" Width="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Background="#F0F3F7">

    <Window.Resources>
        <!-- Modern Flat Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#106EBE"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clean TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="White" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- New Header Row -->
            <RowDefinition Height="*"/>
            <!-- Tabs Row -->
            <RowDefinition Height="Auto"/>
            <!-- Status Bar Row -->
        </Grid.RowDefinitions>

        <!-- Top Header Bar with Logout Button -->
        <Grid Grid.Row="0" Margin="10,10,10,0">
            <TextBlock Text="NGTeco Control Panel" FontSize="20" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center" Margin="5,0"/>

            <Button x:Name="btnLogout" Content="Logout" Width="90" Height="32" 
                    Background="#EF4444" Foreground="White" FontWeight="Bold" Cursor="Hand"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,5"
                    Click="BtnLogout_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <TabControl Grid.Row="1" Margin="10,10,10,5" BorderBrush="#E0E0E0" Background="White">
            <!-- TAB 1: Attendance Logs -->
            <TabItem Header="Attendance Logs" Padding="15,8" FontSize="14" FontWeight="Medium">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,15">
                        <Button x:Name="BtnFetchLogs" Content="⟳ Fetch Logs" Click="TestConnection_Click" Width="135" Margin="0,0,10,0"/>

                        <!-- DATE FILTERS -->
                        <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#555555" FontWeight="SemiBold"/>
                        <DatePicker x:Name="dpStartDate" Width="110" Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#555555" FontWeight="SemiBold"/>
                        <DatePicker x:Name="dpEndDate" Width="110" Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <!-- NAME / ID SEARCH -->
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#555555" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtSearchName" Width="120" Height="30" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid x:Name="dgLogs" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="100"/>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding UserName}" Width="200"/>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="180"/>
                            <DataGridTextColumn Header="Verification Mode" Binding="{Binding VerifyMode}" Width="150"/>
                            <DataGridTextColumn Header="Punch Type" Binding="{Binding InOutMode}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: User Management -->
            <TabItem Header="User Management" Padding="15,8" FontSize="14" FontWeight="Medium">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,15">
                        <Button x:Name="BtnLoadUsers" Content="⟳ Refresh Users" Click="BtnLoadUsers_Click" Width="160"/>
                        <TextBlock Text="Manage local user mappings for the attendance dashboard." VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#666666"/>
                    </StackPanel>

                    <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Background="White">
                        <DataGrid x:Name="dgUsers" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="120"/>
                                <DataGridTextColumn Header="Current Name" Binding="{Binding Name}" Width="300"/>
                                <DataGridTextColumn Header="Role" Binding="{Binding Privilege}" Width="150"/>
                                <DataGridTextColumn Header="Record Status" Binding="{Binding Status}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- ADD NEW USER PANEL -->
                    <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,15,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Add / Update User Mapping" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15" Foreground="#333333" Margin="0,0,25,0"/>

                            <TextBlock Text="User ID:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#555555"/>
                            <TextBox x:Name="txtAddUserId" Width="90" Height="30" Margin="0,0,20,0"/>

                            <TextBlock Text="Full Name:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#555555"/>
                            <TextBox x:Name="txtAddUserName" Width="220" Height="30" Margin="0,0,25,0"/>

                            <Button x:Name="BtnAddUser" Content="+ Save Mapping" Click="BtnAddUser_Click" Width="140" Height="34" Background="#107C41"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: Payroll Summary -->
            <TabItem Header="Payroll" Padding="15,8" FontSize="14" FontWeight="Medium">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,15">
                        <Button x:Name="BtnCalculatePayroll" Content="🧮 Calculate Payroll" Click="BtnCalculatePayroll_Click" Width="165" Margin="0,0,10,0" Background="#107C41"/>

                        <!-- PAYROLL DATE FILTERS -->
                        <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#555555" FontWeight="SemiBold"/>
                        <DatePicker x:Name="dpPayrollStart" Width="110" Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#555555" FontWeight="SemiBold"/>
                        <DatePicker x:Name="dpPayrollEnd" Width="110" Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <!-- PAYROLL SEARCH -->
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#555555" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtPayrollSearch" Width="120" Height="30" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid x:Name="dgPayroll" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="110"/>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding UserName}" Width="220"/>
                            <DataGridTextColumn Header="Days Worked" Binding="{Binding DaysWorked}" Width="130"/>
                            <DataGridTextColumn Header="Total Hours" Binding="{Binding TotalHoursFormatted}" Width="180"/>
                            <DataGridTextColumn Header="Decimal Hours" Binding="{Binding TotalHoursDecimal}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Background="#0078D4" Foreground="White" Padding="10,5">
            <StatusBarItem x:Name="lblStatus" Content="Ready." FontWeight="Medium"/>
        </StatusBar>
    </Grid>
</Window>